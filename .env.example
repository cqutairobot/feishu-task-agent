# Copy this file to .env locally and never commit the real values.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional comma-separated allowlist. New groups may instead use owner
# initialization; leave empty during the first connection.
FEISHU_ALLOWED_CHAT_IDS=

# Optional comma-separated Open IDs allowed to bind names for other members.
# Self-binding does not require this setting.
FEISHU_IDENTITY_ADMIN_OPEN_IDS=

# Legacy transition fallback: comma-separated global task-admin Open IDs.
# Phase 7A stores administrators per group; leave this empty after running
# `python -m app chat-admin grant ...` for each intended group.
FEISHU_TASK_ADMIN_OPEN_IDS=

# Private task cards and lifecycle card actions.
FEISHU_PRIVATE_TASK_CARDS_ENABLED=true
FEISHU_TASK_CARD_ACTIONS_ENABLED=true

# Application log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
FEISHU_LOG_LEVEL=INFO

# Relative SQLite paths are resolved from the project root.
DATABASE_URL=sqlite:///data/feishu_task_agent.db
DATABASE_ECHO=false

# Sliding wait before a queued chat burst becomes available.
DETECTION_DEBOUNCE_SECONDS=20

# Detection Worker safety, context, and retry settings.
DETECTION_WORKER_CONTEXT_LIMIT=30
DETECTION_WORKER_LEASE_SECONDS=300
DETECTION_WORKER_RETRY_BASE_SECONDS=30
DETECTION_WORKER_POLL_SECONDS=2

# Candidates at or above this confidence become todo; lower become pending.
TASK_AUTO_TODO_CONFIDENCE=0.85

# Private natural-language task lifecycle commands.
LIFECYCLE_PRIVATE_WRITES_ENABLED=true
LIFECYCLE_PRIVATE_CONTEXT_LIMIT=20
LIFECYCLE_MUTATION_MIN_CONFIDENCE=0.90

# Durable reminder planning. Times use Asia/Shanghai.
# Test mode replaces the four production moments with deadline -6/-4/-2 and
# +1 minutes. Never leave it enabled in production.
REMINDER_TEST_MODE=false
REMINDER_DUE_DAY_HOUR=9
REMINDER_OVERDUE_GRACE_MINUTES=1
REMINDER_MAX_ATTEMPTS=3

# Reminder delivery Worker safety and polling settings.
REMINDER_WORKER_LEASE_SECONDS=120
REMINDER_WORKER_RETRY_BASE_SECONDS=30
REMINDER_WORKER_POLL_SECONDS=5

# OpenAI-compatible task-detection and lifecycle model.
TASK_LLM_API_KEY=
TASK_LLM_BASE_URL=
TASK_LLM_MODEL=
TASK_LLM_TIMEOUT_SECONDS=60
TASK_LLM_MAX_RETRIES=2

# Loopback-only management page. The Feishu private command
# `管理后台` issues a 5-minute, one-time link to this service.
MANAGEMENT_WEB_ENABLED=true
MANAGEMENT_WEB_PUBLIC_BASE_URL=http://127.0.0.1:8000
MANAGEMENT_WEB_FRONTEND_URL=http://127.0.0.1:3000
MANAGEMENT_WEB_BIND_HOST=127.0.0.1
MANAGEMENT_WEB_PORT=8000
MANAGEMENT_LOGIN_TTL_MINUTES=5
MANAGEMENT_SESSION_TTL_HOURS=12
MANAGEMENT_WEB_COOKIE_SECURE=false
